# Postgres connection string (Neon or Vercel Postgres — use the pooled one)
DATABASE_URL=

# Shared password both operators use to sign in
AUTH_PASSWORD=

# Random secret for signing session cookies — e.g. `openssl rand -base64 32`
AUTH_SECRET=

# Random secret Vercel Cron sends when it hits /api/cron/sync — e.g. `openssl rand -base64 32`
CRON_SECRET=

# Claude API key — required for idea generation and channel analysis
ANTHROPIC_API_KEY=

# vidIQ credentials — optional until the real sync integration is wired up
VIDIQ_API_KEY=
