# SQLite for local dev. Keep the file:./ prefix relative to prisma/schema.prisma.
# Swap to a Postgres connection string + provider = "postgresql" in
# prisma/schema.prisma when moving to Supabase later — no field types in
# the schema are SQLite-specific.
DATABASE_URL="file:./dev.db"

# Claude API key — required for AgentSource (comp retrieval) and, in M4,
# card identification from photos. Never hardcode this; it's read only
# from process.env on the server.
ANTHROPIC_API_KEY=
