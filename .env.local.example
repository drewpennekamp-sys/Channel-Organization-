# Supabase project URL — Supabase dashboard → Project Settings → API
SUPABASE_URL=

# Supabase SERVICE ROLE key — same page as above. This key bypasses Row
# Level Security, which is why it's only ever read on the server (never in
# a 'use client' file) and must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Password you'll use to sign into the app yourself. Pick anything.
AUTH_PASSWORD=

# Random secret for signing session cookies — e.g. `openssl rand -base64 32`
AUTH_SECRET=
