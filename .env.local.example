# Postgres connection string. In production (Vercel) this is set for you
# automatically by the Postgres integration — see README "Deploy". For
# local dev, point it at any reachable Postgres (e.g. your deployed
# instance, or a local one).
DATABASE_URL=

# Claude API key — required for AgentSource (comp retrieval) and for card
# identification from photos. Never hardcode this; it's read only from
# process.env on the server.
ANTHROPIC_API_KEY=

# Vercel Blob token for storing uploaded card photos. Set for you
# automatically by the Blob integration in production. Optional locally —
# without it, photos are written to public/uploads/ on disk instead.
BLOB_READ_WRITE_TOKEN=
