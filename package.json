{
  "name": "livery-lab",
  "version": "0.0.1",
  "private": true,
  "description": "RC Livery Lab — AI livery designer and Cricut cut-file generator for 1/10 scale RC bodies.",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter=./packages/* typecheck",
    "cut-test-sheet": "tsx scripts/cut-test-sheet.ts"
  },
  "dependencies": {
    "@livery-lab/bodies": "workspace:*",
    "@livery-lab/elements": "workspace:*",
    "@livery-lab/geometry": "workspace:*",
    "@livery-lab/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
