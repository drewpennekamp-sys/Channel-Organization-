// Card Comp Tracker — Prisma schema
//
// Provider is PostgreSQL (moved off SQLite so this deploys — SQLite's file
// doesn't survive on serverless hosts like Vercel, where each request can
// land on a fresh filesystem). Every field type below (String, Int, Float,
// Boolean, DateTime) is identical either way, and there are no Postgres-only
// features in use, so the earlier "kept SQLite-compatible" design goal is
// unaffected — this just completes that migration a bit earlier than
// planned. Local dev points at a Postgres instance too now (see README);
// there's one database, not a SQLite-locally/Postgres-in-prod split.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Canonical card identity — one row per distinct card *type*, independent
/// of how many physical copies of it are owned.
model Card {
  id String @id @default(cuid())

  year       Int
  brand      String
  set        String
  /// "" when the card has no subset.
  subset     String  @default("")
  player     String
  cardNumber String
  /// "" for base (no parallel/refractor).
  parallel   String  @default("")
  /// e.g. "/99", "1/1". "" for unnumbered / base cards.
  ///
  /// subset/parallel/serialNumbering use "" rather than null for "not
  /// applicable" deliberately: they're part of the @@unique identity key
  /// below, and both SQLite and Postgres treat every NULL as distinct from
  /// every other NULL in a unique index, so a nullable version of this
  /// constraint would silently admit duplicate Card rows whenever those
  /// fields were empty — exactly the case it exists to catch.
  serialNumbering String @default("")
  isAuto          Boolean @default(false)
  isRelic         Boolean @default(false)
  sport           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  copiesOwned CopyOwned[]
  sales       Sale[]

  // Prevents accidentally creating a duplicate Card row for the same
  // physical card identity (e.g. re-running a seed or a scan-to-save flow
  // twice). All the attributes that distinguish one card from another are
  // part of the key.
  @@unique([year, brand, set, subset, player, cardNumber, parallel, serialNumbering, isAuto, isRelic, sport], name: "cardIdentity")
  @@index([player])
  @@index([year, brand, set])
}

/// A physical copy I own of a Card, in a specific grade.
model CopyOwned {
  id String @id @default(cuid())

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Restrict)

  /// "RAW", "PSA 10", "BGS 9.5", "SGC 9", etc. Free-text, validated by zod
  /// at the API boundary rather than a DB enum (SQLite has none, and this
  /// keeps the schema identical on Postgres).
  grade String

  /// Set only for graded copies (PSA/BGS/SGC cert number on the slab).
  certNumber String?

  purchasePrice Float?
  purchaseDate  DateTime?

  frontImagePath String?
  backImagePath  String?

  notes String?

  /// How this copy's identity was determined by the scanner (see
  /// lib/scanner/) — "exact" (cert), "high" (catalog match, closed-list
  /// parallel), "low" (catalog matched, parallel uncertain), "unresolved"
  /// (manual entry), or null for copies added before the scanner existed /
  /// entered by hand without ever running a scan. Never a numeric score —
  /// see lib/scanner/types.ts for why.
  identificationConfidence String?

  /// Which resolution rule produced identificationConfidence — "cert",
  /// "catalog-exact", "catalog-year-offset", "catalog-prefix", or
  /// "unresolved". Logged so it's visible which rule is doing the work.
  identificationMethod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  valuations Valuation[]

  @@index([cardId])
}

/// Reference knowledge about one (set, cardNumber) pair — what Pass 2 of
/// the scanner resolves against. Deliberately NOT bulk-seeded from an
/// external export: it grows from confirmed scans instead (see
/// app/api/cards/route.ts), so day one has zero coverage and every
/// confirmed high-confidence save teaches the catalog one more card. A
/// CatalogCard is reference data, independent of how many Card/CopyOwned
/// rows end up pointing at it.
model CatalogCard {
  id String @id @default(cuid())

  brand  String
  year   Int
  set    String
  subset String @default("")

  /// Full string including any insert prefix, e.g. "EA-BB", never stripped.
  cardNumber String
  /// The prefix portion only (e.g. "EA-BB" -> "EA"), extracted at write
  /// time — Pass 2's prefix-match resolution rule filters on this.
  cardNumberPrefix String @default("")

  player String
  sport  String

  isAuto  Boolean @default(false)
  isRelic Boolean @default(false)

  /// The copyright year actually observed on a confirmed scan of this
  /// card — distinct from `year` (the product/season year) because a
  /// late-year release prints next season's copyright. Nullable: not
  /// every confirmed scan has a back photo with a legible copyright line.
  copyrightYear Int?

  parallels CatalogParallel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brand, year, set, subset, cardNumber], name: "catalogIdentity")
  @@index([cardNumber, player])
  @@index([cardNumberPrefix, player])
}

/// One known parallel/insert-color variant of a CatalogCard, in rarity
/// order — the closed list Pass 3 must choose from. Grows the same way
/// CatalogCard does: a confirmed scan of a parallel not yet on record adds
/// it here.
model CatalogParallel {
  id String @id @default(cuid())

  catalogCardId String
  catalogCard   CatalogCard @relation(fields: [catalogCardId], references: [id], onDelete: Cascade)

  /// Display name, e.g. "Green", "Gold", "SuperFractor" — "Base" for the
  /// unparalleled version, always present as the first row for a card.
  name String

  /// The serial print run (e.g. 99 for "/99"), null for Base/unnumbered
  /// parallels and for true 1/1s (see oneOfOne).
  printRun Int?
  oneOfOne Boolean @default(false)

  /// Sort position, rarest last — the order the closed-list prompt shows
  /// candidates in and the order ties get broken in.
  rarityOrder Int @default(0)

  createdAt DateTime @default(now())

  @@unique([catalogCardId, name])
  @@index([catalogCardId, printRun])
}

/// One observed SOLD listing for a Card+grade. Append-only: rows are never
/// updated or deleted once inserted — price history and reproducibility of
/// past Valuations depend on that. The unique constraint on sourceUrl is
/// the dedupe guard against re-retrieving the same sale on a later refresh.
model Sale {
  id String @id @default(cuid())

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Restrict)

  grade String

  /// Final sale price in USD, excluding shipping.
  price    Float
  saleDate DateTime

  marketplace   String
  listingTitle  String
  sourceUrl     String @unique

  /// When this row was retrieved/inserted, distinct from saleDate.
  retrievedAt DateTime @default(now())

  /// "agent" (Claude web-search retrieval) | "api" (future paid data API).
  sourceType String

  /// Free-text caveats, e.g. "price includes bundled shipping".
  notes String?

  valuationsUsedIn ValuationSaleUsed[]

  @@index([cardId, grade])
  @@index([saleDate])
}

/// A computed valuation snapshot for one owned copy. Never mutated after
/// creation — refreshing produces a new row so history is preserved.
/// Reproducibility: valuationsUsedIn / ValuationSaleUsed records exactly
/// which Sale rows fed this number.
model Valuation {
  id String @id @default(cuid())

  copyOwnedId String
  copyOwned   CopyOwned @relation(fields: [copyOwnedId], references: [id], onDelete: Cascade)

  /// Null when sufficient = false — never a fabricated/interpolated number.
  value Float?
  low   Float?
  high  Float?

  sampleSize Int
  sufficient Boolean

  /// Identifies the scoring algorithm version, e.g.
  /// "weighted-median-180d-v1", so future algorithm changes are visible
  /// in stored history rather than silently reinterpreted.
  method String

  computedAt DateTime @default(now())

  salesUsed ValuationSaleUsed[]

  @@index([copyOwnedId, computedAt])
}

/// Join table recording exactly which Sale rows a Valuation was computed
/// from — the audit trail the Card Detail screen renders.
model ValuationSaleUsed {
  valuationId String
  valuation   Valuation @relation(fields: [valuationId], references: [id], onDelete: Cascade)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@id([valuationId, saleId])
  @@index([saleId])
}
